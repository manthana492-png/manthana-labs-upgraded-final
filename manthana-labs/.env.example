VITE_SUPABASE_URL=https://<YOUR_SUPABASE_PROJECT_REF>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<YOUR_SUPABASE_ANON_KEY>

# Edge Function secrets (set in Supabase Dashboard → Project → Edge Functions → Secrets)
MOONSHOT_API_KEY=<YOUR_MOONSHOT_API_KEY>
NVIDIA_API_KEY=<YOUR_NVIDIA_NIM_API_KEY>

# Transactional email via SMTP (any provider: Gmail, Zoho, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<YOUR_SMTP_USERNAME>
SMTP_PASS=<YOUR_SMTP_PASSWORD_OR_APP_PASSWORD>
SMTP_FROM=noreply@yourdomain.com
